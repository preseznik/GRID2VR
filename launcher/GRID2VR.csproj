<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GRID2VR</AssemblyName>
    <Version>0.2.1</Version>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">Stable</ReleaseChannel>
    <BuildUtc Condition="'$(BuildUtc)' == ''">Development build</BuildUtc>
    <BuildRevision Condition="'$(BuildRevision)' == ''">local</BuildRevision>
    <ApplicationIcon>assets\GRID2VR.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\tools\GameExecutable.cs" Link="GameExecutable.cs" />
    <Compile Include="..\tools\HardwareSettingsPath.cs" Link="HardwareSettingsPath.cs" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <AssemblyMetadata Include="BuildUtc" Value="$(BuildUtc)" />
    <AssemblyMetadata Include="BuildRevision" Value="$(BuildRevision)" />
    <EmbeddedResource Include="assets\GRID2VR.ico" LogicalName="GRID2VR.ico" />
    <EmbeddedResource Include="assets\GRID2VR.png" LogicalName="GRID2VR.png" />
    <EmbeddedResource Include="..\tools\data\cockpit-texture-pack.json" LogicalName="GRID2VR.CockpitPack.json" />
    <EmbeddedResource Include="..\tools\data\graphics-options.json" LogicalName="GRID2VR.GraphicsOptions.json" />
  </ItemGroup>
</Project>
